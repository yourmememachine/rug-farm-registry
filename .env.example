# Copy to .env and fill in. Never commit .env.
# Helius API key for the indexer (src/indexer.py) and the daily scan
# (src/daily_scan.py). Get a free key at https://www.helius.dev —
# the free tier is enough for the daily scan (50 creations/day).
# Leave blank to keep the indexer disabled — the API and tests work
# without it, and the daily scan exits 2 with a clear message.
HELIUS_API_KEY=

# DexScreener (used for mint outcomes in src/indexer.py) needs no key.

# Optional: override the registry file the API loads.
# REGISTRY_PATH=data/registry.json
